        object Label17: TLabel
          Left = 108
          Top = 114
          Width = 219
          Height = 185
          AutoSize = False
          Caption = 
            'Para Importar: Arrume os dados numa Tabela Excel (.xls) com as c' +
            'olunas dispostas de acordo com os campos da lista ao lado, sendo' +
            ' que os dados deve ser configurados como texto. Salve os dados c' +
            'omo arquivo de extens'#227'o ".csv". Preencha no campo "Arquivo"  aci' +
            'ma indicado e pressione o bot'#227'o "Importar" para executar a impor' +
            'ta'#231#227'o dos dados. Para Exportar:  Digite o nome do arquivo ".csv"' +
            ' que deseja gravar os dados a serem exportados em seguida pressi' +
            'one o bot'#227'o "Exportar".'
          WordWrap = True
        end
